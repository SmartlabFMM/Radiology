<odoo>

    <!-- =========================
         ACTION
    ========================== -->
    <record id="action_radiology_working_hours" model="ir.actions.act_window">
        <field name="name">Working Hours</field>
        <field name="res_model">radiology.working.hours</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure working hours for machines and radiologists
            </p>
        </field>
    </record>


    <!-- =========================
         list VIEW
    ========================== -->
    <record id="view_radiology_working_hours_list" model="ir.ui.view">
        <field name="name">radiology.working.hours.list</field>
        <field name="model">radiology.working.hours</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="line_ids">
                    <list>
                        <field name="weekday"/>
                        <field name="hour_from"/>
                        <field name="hour_to"/>
                    </list>
                </field>
            </list>
        </field>
    </record>


    <!-- =========================
        FORM VIEW
    ========================== -->
    <record id="view_radiology_working_hours_form" model="ir.ui.view">
        <field name="name">radiology.working.hours.form</field>
        <field name="model">radiology.working.hours</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Pick Available Slot"
                            name="action_open_slot_wizard"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="radiologist_id" required="1"/>
                        <field name="resource_id" required="1"/>
                        <field name="state" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="weekday"/>
                                    <field name="hour_from"/>
                                    <field name="hour_to"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- =========================
         MENU STRUCTURE
    ========================== -->

    <menuitem id="menu_radiology_config"
              name="Configuration"
              parent="menu_radiology_root"
              sequence="20"/>

    <menuitem id="menu_radiology_working_hours"
              name="Working Hours"
              parent="menu_radiology_config"
              action="action_radiology_working_hours"
              sequence="10"/>

</odoo>