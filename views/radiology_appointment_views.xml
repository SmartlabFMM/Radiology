<odoo>

<!-- LIST -->
<record id="view_radiology_appointment_list" model="ir.ui.view">
    <field name="name">radiology.appointment.list</field>
    <field name="model">radiology.appointment</field>
    <field name="arch" type="xml">
        <list>
            <field name="patient_id"/>
            <field name="resource_id"/>
            <field name="start"/>
            <field name="stop"/>
            <field name="state"/>
            <field name="priority"/>
        </list>
    </field>
</record>

    <!-- CALENDAR -->
    <record id="view_radiology_appointment_calendar" model="ir.ui.view">
        <field name="name">radiology.appointment.calendar</field>
        <field name="model">radiology.appointment</field>
        <field name="arch" type="xml">

            <calendar string="Radiology Schedule"
                    date_start="start"
                    date_stop="stop"
                    mode="month"
                    color="resource_id">

                <field name="patient_id"/>
                <field name="resource_id"/>
                <field name="state"/>

            </calendar>

        </field>
    </record>

    <!-- FORM -->
    <record id="view_radiology_appointment_form" model="ir.ui.view">
        <field name="name">radiology.appointment.form</field>
        <field name="model">radiology.appointment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="patient_id"/>
                        <field name="radiologist_id"/>
                        <field name="resource_id"/>
                    </group>

                    <group>
                        <field name="start"/>
                        <field name="stop"/>
                        <field name="duration" readonly="1"/>
                    </group>

                    <group>
                        <field name="state"/>
                        <field name="priority"/>
                    </group>

                    <field name="notes"/>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_radiology_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">radiology.appointment</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

</odoo>